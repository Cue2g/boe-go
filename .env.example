# Copia este archivo a .env y ajusta los valores. sboe lo carga automáticamente
# (las variables ya definidas en el entorno tienen prioridad).

# Base de datos
SBOE_DB_PATH=./data/sboe.db

# Servidor web
SBOE_ADDR=:8080
# URL pública: se usa en los enlaces de los emails
SBOE_BASE_URL=http://localhost:8080
# 1 si se sirve por HTTPS
SBOE_COOKIE_SECURE=0
# Zona horaria de los horarios de jobs y alertas
SBOE_TZ=Europe/Madrid

# Pausa aleatoria entre peticiones a las webs
SBOE_MIN_DELAY=1s
SBOE_MAX_DELAY=3s

# Email con Resend (https://resend.com/api-keys). Si hay API key se usa Resend y se ignora SMTP.
# SBOE_RESEND_FROM debe pertenecer a un dominio verificado en Resend (https://resend.com/domains).
SBOE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
SBOE_RESEND_FROM=Alertas SBOE <alertas@tudominio.com>

# Alternativa: SMTP (p. ej. Gmail con contraseña de aplicación, https://myaccount.google.com/apppasswords).
# Si no hay Resend ni SBOE_SMTP_HOST, los emails solo se escriben en el log.
SBOE_SMTP_HOST=
SBOE_SMTP_PORT=587
SBOE_SMTP_USER=tu-cuenta@gmail.com
SBOE_SMTP_PASS=xxxxxxxxxxxxxxxx
SBOE_SMTP_FROM=tu-cuenta@gmail.com
